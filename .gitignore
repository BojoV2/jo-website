node_modules
frontend/node_modules
frontend/dist
.env
.env.*
!.env.example
npm-debug.log
backend-dev.log
frontend-dev.log

# user uploads / generated artefacts — customer data, never commit
storage/*
!storage/.gitkeep
!storage/templates/.gitkeep
!storage/generated/.gitkeep

# local rollback copies
*.bak
*.bak-*
*.orig
.attic/

# MAC-Finder — live data/config, never commit (real creds + a large sqlite db)
macfinder/data/*
macfinder/config/*.json
!macfinder/config/*.example.json
